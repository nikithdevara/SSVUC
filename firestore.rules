rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Operational Collections for Sri Siddhi Vinayaka Utsava Committee 2026
    match /settings/{docId} { allow read, write: if true; }
    match /events/{docId} { allow read, write: if true; }
    match /announcements/{docId} { allow read, write: if true; }
    match /gallery/{docId} { allow read, write: if true; }
    match /expenses/{docId} { allow read, write: if true; }
    match /donations/{docId} { allow read, write: if true; }
    match /materials/{docId} { allow read, write: if true; }
    match /receipts/{docId} { allow read, write: if true; }
    match /contactMessages/{docId} { allow read, write: if true; }
    match /messages/{docId} { allow read, write: if true; }
    match /payments/{docId} { allow read, write: if true; }
    match /auditLogs/{docId} { allow read, write: if true; }
    match /audit_logs/{docId} { allow read, write: if true; }
    match /users/{docId} { allow read, write: if true; }
    match /admin_users/{docId} { allow read, write: if true; }
    match /notifications/{docId} { allow read, write: if true; }
    
    // Master fallback rule for all festival documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

