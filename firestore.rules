rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
          ? get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data
          : {};
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (getUserData().role == 'SUPER_ADMIN' || getUserData().role == 'super_admin');
    }
    
    function isTreasurer() {
      return isAuthenticated() && (
        getUserData().role == 'TREASURER' || 
        getUserData().role == 'treasurer' || 
        getUserData().role == 'SUPER_ADMIN' || 
        getUserData().role == 'super_admin'
      );
    }
    
    function isCommitteeAdmin() {
      return isAuthenticated();
    }

    // Public Collections - Read-Only for Public, Write for Committee Admins
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /events/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /gallery/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Public Contact Inquiries / Devotee Messages
    match /messages/{docId} {
      allow read, create, update, delete: if true;
    }
    match /contactMessages/{docId} {
      allow read, create, update, delete: if true;
    }

    // Monetary Donations
    match /donations/{docId} {
      allow read, create, update, delete: if true;
    }

    // Material Donations
    match /materials/{docId} {
      allow read, create, update, delete: if true;
    }

    // Expenses - Financial Management & Public Transparency
    match /expenses/{docId} {
      allow read, create, update, delete: if true;
    }

    // Digital Receipts - Public Verification & Admin Management
    match /receipts/{receiptId} {
      allow read, create, update, delete: if true;
    }

    // Payment Gateway Logs & Reconciliation
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Audit Logs - Immutable Append-Only Ledger
    match /audit_logs/{logId} {
      allow read, write: if true;
    }
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Admin Users Management
    match /users/{userId} {
      allow read, write: if true;
    }
    match /admin_users/{userId} {
      allow read, write: if true;
    }

    // Admin Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
  }
}
